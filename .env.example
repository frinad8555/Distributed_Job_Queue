# API server
PORT=3000

# PostgreSQL application database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_queue
DB_USER=postgres
DB_PASSWORD=change-me

# Dedicated test database (must be named job_queue_test)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=job_queue_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=change-me

# Worker simulation delay, in milliseconds
JOB_PROCESSING_DELAY_MS=3000

# Optional load-test settings
BASE_URL=http://localhost:3000
TOTAL_JOBS=1000
CONCURRENCY=10
POLL_INTERVAL_MS=500
TIMEOUT_MS=1800000
